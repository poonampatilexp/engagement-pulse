# Dedicated FastAPI database connection string (isolated from Django's engagement_pulse DB)
DATABASE_URL=postgresql+psycopg://pulse_user:pulse_password@localhost:5432/engagement_pulse_fastapi

# JWT Secret Key for token signing (use a strong random 256-bit+ secret in production)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars

# Development-only seed credentials (DEVELOPMENT ONLY - NEVER USE IN PRODUCTION)
# Passwords used by `python seed.py` to create initial local demo users.
SEED_CONSULTANT_PASSWORD=ConsultantDevPass#2026
SEED_CLIENT_VIEWER_PASSWORD=ViewerDevPass#2026
